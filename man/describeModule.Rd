\name{describeModule}
\alias{describeModule}
\title{Identity of the Installed Module}
\description{
Returns the name and the installed version of the package.
}
\usage{
describeModule()
}
\value{
A list with \code{package}, the string \code{"xemd"}, and \code{version},
the installed version as a string.
}
\seealso{
\code{\link{listOperations}}, \code{\link{listDecompositions}}
}
\examples{
describeModule()
}
